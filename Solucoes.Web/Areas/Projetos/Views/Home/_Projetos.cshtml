@using Solucoes.Web.Extensions

@model IEnumerable<Solucoes.Web.Areas.Projetos.Models.Projeto.ProjetoViewModel>

@functions {
	DateTime? ConverterEmLocalTime(DateTime? data)
	{
		if (!data.HasValue)
		{
			return null;
		}

		DateTime dataConvertida = DateTime.SpecifyKind(data.Value, DateTimeKind.Utc);
		return dataConvertida.ToLocalTime();
	}

	string ConverterEmTempoDecorrido(DateTime? data)
	{
		if (!data.HasValue)
		{
			return "";
		}

		TimeSpan diferenca = DateTime.Now - data.Value;

		if (diferenca.TotalSeconds < 60)
		{
			return FormatarPlural(diferenca.TotalSeconds.Ceil(), "segundo");
		}
		else if (diferenca.TotalMinutes < 60)
		{
			return FormatarPlural(diferenca.TotalMinutes.Ceil(), "minuto");
		}
		else if (diferenca.TotalHours < 24)
		{
			return FormatarPlural(diferenca.TotalHours.Ceil(), "hora");
		}
		else if (diferenca.TotalDays < 7)
		{
			return FormatarPlural(diferenca.TotalDays.Ceil(), "dia");
		}
		else if (diferenca.TotalDays < 30)
		{
			return FormatarPlural((diferenca.TotalDays / 7).Ceil(), "semana");
		}
		else if (diferenca.TotalDays < 365)
		{
			return FormatarPlural((diferenca.TotalDays / 30).Ceil(), "mês");
		}
		else
		{
			return FormatarPlural((diferenca.TotalDays / 365).Ceil(), "ano");
		}
	}

	string FormatarPlural(int quantidade, string unidade)
	{
		unidade = unidade.ToLower();
		var unidadePlural = quantidade == 1 ? unidade : (unidade == "mês" ? "meses" : unidade + "s");

		return $"Criado há {quantidade} {unidadePlural} atrás";
	}
}

@if (Model.Count() > 0)
{
	<div class="row">
		@foreach (var item in Model)
		{
			<div class="col-12 mb-3">
				<div class="card shadow-sm projeto">
					<div class="card-body">
						<a class="card-title h4 text-primary text-decoration-none d-inline-block mb-3" asp-area="Projetos" asp-controller="Projeto" asp-action="Index" asp-route-id="@item.Id">
							@item.Nome
						</a>
						<p class="text-muted">
							<small>@ConverterEmTempoDecorrido(ConverterEmLocalTime(item.CriadoEm))</small>
						</p>
						@if (!string.IsNullOrEmpty(item.Descricao))
						{
							<p class="card-text text-truncate" title="@item.Descricao">
								@item.Descricao
							</p>
						}
						<div class="mb-3">
							<span class="me-2">
								<i class="fa-solid fa-users"></i>
								@item.QuantidadeMembros @(item.QuantidadeMembros == 1 ? "membro" : "membros")
							</span>
							<span>
								<i class="fa-solid fa-arrows-spin"></i>
								@item.QuantidadeSprints @(item.QuantidadeSprints == 1 ? "sprint" : "sprints")
							</span>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}
else
{
	<div class="row">
		<div class="col-12 py-3">
			<p class="text-center text-muted">Você ainda não criou nenhum projeto...</p>
		</div>
	</div>
}