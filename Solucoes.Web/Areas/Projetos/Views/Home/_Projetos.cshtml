@using Solucoes.Web.Extensions

@model IEnumerable<Solucoes.Web.Areas.Projetos.Models.Home.ProjetoViewModel>

@functions {
	DateTime? ConverterEmLocalTime(DateTime? data)
	{
		if (!data.HasValue)
		{
			return null;
		}

		DateTime dataConvertida = DateTime.SpecifyKind(data.Value, DateTimeKind.Utc);
		return dataConvertida.ToLocalTime();
	}

	string ConverterEmTempoDecorrido(DateTime? data)
	{
		if (!data.HasValue)
		{
			return "";
		}

		TimeSpan diferenca = DateTime.Now - data.Value;

		if (diferenca.TotalSeconds < 60)
		{
			return FormatarPlural(diferenca.TotalSeconds.Ceil(), "segundo");
		}
		else if (diferenca.TotalMinutes < 60)
		{
			return FormatarPlural(diferenca.TotalMinutes.Ceil(), "minuto");
		}
		else if (diferenca.TotalHours < 24)
		{
			return FormatarPlural(diferenca.TotalHours.Ceil(), "hora");
		}
		else if (diferenca.TotalDays < 7)
		{
			return FormatarPlural(diferenca.TotalDays.Ceil(), "dia");
		}
		else if (diferenca.TotalDays < 30)
		{
			return FormatarPlural((diferenca.TotalDays / 7).Ceil(), "semana");
		}
		else if (diferenca.TotalDays < 365)
		{
			return FormatarPlural((diferenca.TotalDays / 30).Ceil(), "mês");
		}
		else
		{
			return FormatarPlural((diferenca.TotalDays / 365).Ceil(), "ano");
		}
	}

	string FormatarPlural(int quantidade, string unidade)
	{
		unidade = unidade.ToLower();
		var unidadePlural = quantidade == 1 ? unidade : (unidade == "mês" ? "meses" : unidade + "s");

		return $"Criado há {quantidade} {unidadePlural} atrás";
	}
}

<div class="row">
	@if (Model.Count() > 0)
	{
		<div class="col-sm-12 offset-md-4 col-md-4 mb-3">
			<div class="input-group">
				<span class="input-group-text" id="basic-addon1">
					<i class="fa-solid fa-magnifying-glass"></i>
				</span>
				<input type="text" id="pesquisar-projeto" class="form-control" placeholder="Pesquisar projeto" aria-describedby="basic-addon1" oninput="filtrarProjetos(event)">
			</div>
		</div>
		@foreach (var item in Model)
		{
			<div class="col-sm-12 col-md-6 mb-3">
				<div class="card projeto">
					<div class="card-header d-flex align-items-center justify-content-between">
						<p class="m-0">
							<i class="fa-solid fa-diagram-project"></i>
							Projeto
						</p>
						<div class="dropdown">
							<button type="button" class="btn btn-light" id="project-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="fa-solid fa-ellipsis"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-start" aria-labelledby="project-dropdown">
								<li>
									<a class="dropdown-item" asp-area="Projetos" asp-controller="Projeto" asp-action="Index" asp-route-id="@item.Id">Abrir</a>
								</li>
								<li>
									<hr class="dropdown-divider" />
								</li>
								<li>
									<button type="button" class="dropdown-item">
										<i class="fa-solid fa-pen-to-square"></i>
										Editar
									</button>
								</li>
								<li>
									<button type="button" class="dropdown-item">
										<i class="fa-solid fa-trash-can"></i>
										Excluir
									</button>
								</li>
							</ul>
						</div>
					</div>
					<div class="card-body">
						<a class="card-title h4 text-primary text-decoration-none d-inline-block mb-3" asp-area="Projetos" asp-controller="Projeto" asp-action="Index" asp-route-id="@item.Id">
							@item.Nome
						</a>
						<p class="card-text text-truncate" title="@item.Descricao">
							@item.Descricao
						</p>
						<div class="mb-3">
							<span class="badge bg-info text-light">
								@item.QuantidadeMembros @(item.QuantidadeMembros == 1 ? "membro" : "membros") no projeto
							</span>
						</div>
					</div>
					<div class="card-footer text-muted">
						<small>@ConverterEmTempoDecorrido(ConverterEmLocalTime(item.CriadoEm))</small>
					</div>
				</div>
			</div>
		}
	}
	else
	{
		<div class="col-12 py-3">
			<p class="text-center text-muted">Você ainda não criou nenhum projeto...</p>
		</div>
	}
</div>