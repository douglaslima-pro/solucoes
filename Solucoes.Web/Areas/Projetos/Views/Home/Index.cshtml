@using Solucoes.Web.Areas.Projetos.Models.Home

@model IEnumerable<ProjetoViewModel>

@{
	ViewData["Title"] = "Página Inicial - Projetos";
}

@section Styles {
	<style>
		a.card-title:hover {
			text-decoration: underline !important;
		}
	</style>
}

<div class="container py-5">
	<div class="row">
		<div class="col-12 mb-3">
			<h1>Bem-vindo, @(ViewBag.UsuarioNome)!</h1>
			<p>Esta é a página inicial da área de projetos.</p>
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<div class="card">
				<div class="card-body">
					<div class="row my-4">
						<div class="col-sm-12 col-md-12 col-lg-3 mb-3">
							<h3 class="m-0">Meus projetos</h3>
						</div>
						<div class="col-sm-12 col-md-7 col-lg-5 mb-3">
							<div class="input-group">
								<span class="input-group-text" id="basic-addon1">
									<i class="fa-solid fa-magnifying-glass"></i>
								</span>
								<input type="text" id="pesquisar-projeto" class="form-control" placeholder="Pesquisar projeto" aria-describedby="basic-addon1" oninput="filtrarProjetos(event)">
							</div>
						</div>
						<div class="col-sm-12 col-md-5 col-lg-4 mb-3 d-flex align-items-center justify-content-end gap-2">
							<button type="button" class="btn btn-light" onclick="recarregarProjetos()">
								<i class="fa-solid fa-arrows-rotate"></i>
								Atualizar
							</button>
							<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarProjeto">
								<i class="fa-solid fa-plus"></i>
								Criar projeto
							</button>
						</div>
					</div>
					<div id="projetosContainer">
						@await Html.PartialAsync("_Projetos", Model)
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@{
	await Html.RenderPartialAsync("_ModalCriarProjeto", new ProjetoViewModel());
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$(function () {
			setInterval(() => {
				recarregarProjetos()
			}, 60000)

			$("#submitFormCriarProjeto").on("click", function () {
				$("#formCriarProjeto").trigger("submit")
			})

			$("#formCriarProjeto").on("submit", function (e) {
				e.preventDefault()

				const formElement = this

				if (!$(formElement).valid()) {
					return
				}

				$.ajax({
					url: "@Url.Action("Criar", "Projeto", new { area = "Projetos" })",
					type: "post",
					dataType: "json",
					contentType: false,
					processData: false,
					data: new FormData(formElement)
				}).done(function () {
					$("#modalCriarProjeto").modal("hide")
					showAlert("success", "Projeto criado com sucesso!")

					$(formElement)[0].reset()
					$(formElement).validate().resetForm()

					recarregarProjetos()
				}).fail(function (xhr) {
					if (xhr.status == 400) {
						var response = JSON.parse(xhr.responseText)
						$(formElement).validate().showErrors(response.erros)
					}
				})
			})
		})

		function recarregarProjetos() {
			$("#projetosContainer").html(`
				<div class="row">
					<div class="col-12 py-3">
						<p class="text-center text-muted">
							<span class="spinner-border" role="status"></span>
							Carregando os seus projetos...
						</p>
					</div>
				</div>
			`)

			$.ajax({
				url: "@Url.Action("Projetos", "Home", new { area = "Projetos" })",
				type: "get"
			}).done(function (dados) {
				$("#projetosContainer").html(dados)
			}).fail(function () {
				window.location.reload()
			})
		}

		function filtrarProjetos(e) {
			var filtro = e.target.value.toLowerCase()

			var projetos = Array.from(document.getElementsByClassName("projeto"))

			for (var p of projetos) {
				if (p.querySelector(".card-title").innerText.toLowerCase().includes(filtro)) {
					p.parentElement.classList.remove("d-none")
				} else {
					p.parentElement.classList.add("d-none")
				}
			}
		}
	</script>
}