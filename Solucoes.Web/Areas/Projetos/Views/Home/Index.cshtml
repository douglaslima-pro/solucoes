@using Solucoes.Web.Areas.Projetos.Models.Home

@model IEnumerable<ProjetoViewModel>

@{
	ViewData["Title"] = "Página Inicial - Projetos";
}

@section Styles {
	<style>
		a.card-title:hover {
			text-decoration: underline !important;
		}
	</style>
}

<div class="container py-5">
	<div class="row">
		<div class="col-12 mb-3">
			<h1>Bem-vindo, @(ViewBag.UsuarioNome)!</h1>
			<p>Esta é a página inicial da área de Projetos.</p>
			<p>Aqui você pode gerenciar seus projetos, convites e tarefas.</p>
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<div class="card">
				<div class="card-header">
					<ul class="nav nav-tabs card-header-tabs" id="tab" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="projetos-tab" data-bs-toggle="tab" data-bs-target="#projetos" type="button" role="tab" aria-controls="projetos" aria-selected="true">
								<i class="fa-solid fa-diagram-project"></i>
								Projetos
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="convites-tab" data-bs-toggle="tab" data-bs-target="#convites" type="button" role="tab" aria-controls="convites" aria-selected="false">
								<i class="fa-regular fa-envelope"></i>
								Convites
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="tarefas-tab" data-bs-toggle="tab" data-bs-target="#tarefas" type="button" role="tab" aria-controls="tarefas" aria-selected="false">
								<i class="fa-regular fa-calendar-check"></i>
								Tarefas
							</button>
						</li>
					</ul>
				</div>
				<div class="card-body">
					<div class="tab-content" id="tab-content">
						<div class="tab-pane fade show active" id="projetos" role="tabpanel" aria-labelledby="projetos-tab">
							<div class="row my-4">
								<div class="col-sm-12 col-md-4">
									<h3>Meus projetos</h3>
								</div>
								<div class="col-sm-12 col-md-8 d-flex align-items-center justify-content-end gap-2">
									<button type="button" class="btn btn-light" onclick="recarregarProjetos()">
										<i class="fa-solid fa-arrows-rotate"></i>
										Atualizar
									</button>
									<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCriarProjeto">
										<i class="fa-solid fa-plus"></i>
										Criar projeto
									</button>
								</div>
							</div>
							<div id="projetosContainer">
								@await Html.PartialAsync("_Projetos", Model)
							</div>
						</div>
						<div class="tab-pane fade" id="convites" role="tabpanel" aria-labelledby="convites-tab">
							@{
								await Html.RenderPartialAsync("_Convites");
							}
						</div>
						<div class="tab-pane fade" id="tarefas" role="tabpanel" aria-labelledby="tarefas-tab">
							@{
								await Html.RenderPartialAsync("_Tarefas");
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@{
	await Html.RenderPartialAsync("_ModalCriarProjeto", new ProjetoViewModel());
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$(function () {
			setInterval(() => {
				recarregarProjetos()
			}, 120000)

			$("#submitFormCriarProjeto").on("click", function () {
				$("#formCriarProjeto").trigger("submit")
			})

			$("#formCriarProjeto").on("submit", function (e) {
				e.preventDefault()

				const formElement = this

				if (!$(formElement).valid()) {
					return
				}

				$.ajax({
					url: "@Url.Action("Criar", "Projeto", new { area = "Projetos" })",
					type: "post",
					dataType: "json",
					contentType: false,
					processData: false,
					data: new FormData(formElement)
				}).done(function () {
					$("#modalCriarProjeto").modal("hide")
					showAlert("success", "Projeto criado com sucesso!")

					$(formElement)[0].reset()
					$(formElement).validate().resetForm()

					recarregarProjetos()
				}).fail(function (xhr) {
					if (xhr.status == 400) {
						var response = JSON.parse(xhr.responseText)
						$(formElement).validate().showErrors(response.erros)
					}
				})
			})
		})

		function recarregarProjetos() {
			$("#projetosContainer").html(`
				<div class="row">
					<div class="col-12 py-3">
						<p class="text-center text-muted">
							<span class="spinner-border" role="status"></span>
							Carregando os seus projetos...
						</p>
					</div>
				</div>
			`)

			$.ajax({
				url: "@Url.Action("Projetos", "Home", new { area = "Projetos" })",
				type: "get"
			}).done(function (dados) {
				$("#projetosContainer").html(dados)
			}).fail(function () {
				window.location.reload()
			})
		}

		function filtrarProjetos(e) {
			var filtro = e.target.value.toLowerCase()

			var projetos = Array.from(document.getElementsByClassName("projeto"))

			for (var p of projetos) {
				if (p.querySelector(".card-title").innerText.toLowerCase().includes(filtro)) {
					p.parentElement.classList.remove("d-none")
				} else {
					p.parentElement.classList.add("d-none")
				}
			}
		}
	</script>
}